# Variáveis de ambiente do Cuida+ (plan 000, D-43).
# Copie para `.env` na raiz e ajuste. O `.env` NÃO vai para o git; este modelo vai.
# Quem lê: Docker Compose (docker-compose.yml) e o backend Spring (spring.config.import).

# ---------- Banco (docker-compose + backend) ----------
POSTGRES_DB=cuida
POSTGRES_USER=cuida
POSTGRES_PASSWORD=cuida
POSTGRES_PORT=5432
# URL que o backend usa; em dev aponta para o container do compose
DB_URL=jdbc:postgresql://localhost:5432/cuida

# ---------- E-mail (D-24) ----------
# dev/test: Mailpit do compose (captura tudo, nada sai para a internet)
MAIL_HOST=localhost
MAIL_PORT=1025
# prod: Gmail SMTP com senha de app (verificação em duas etapas obrigatória)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Cuida+ <nao-responda@cuidamais.local>

# ---------- Backend ----------
# dev | test | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---------- Sessão (T-021, D-11) ----------
# Segredo HMAC (HS256, mínimo 32 bytes) do access token JWT. Gere o seu próprio no seu `.env`
# local (nunca neste arquivo de exemplo nem em nenhum outro lugar versionado):
#   openssl rand -base64 48
# Cada ambiente (sua máquina, teste, produção) tem o seu próprio valor, nunca compartilhado.
JWT_SECRET=

# ---------- Jobs agendados (plan D-09, R-06) ----------
# Um único @Scheduled chama as rotinas idempotentes (expiração, descarte, retenção, reenvio).
# Padrões: ligado, a cada 5 min (Duration ISO-8601). Rode em UMA instância só (R-06).
# JOBS_ENABLED=true
# JOBS_INTERVAL=PT5M

# ---------- Ferramentas (só para a máquina do dev; não é lida pela aplicação) ----------
# JDK 25 usado pelo Maven. Ex.: C:\Users\voce\.jdks\jdk-25.0.4.1+1
# JAVA_HOME=
